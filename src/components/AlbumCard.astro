---
import type { Lang } from '../types/lang';
import type { AlbumEntry } from '../lib/content';
import { albumTitle } from '../lib/content';
import { formatAlbumPhotoCount, t } from '../i18n/ui';
import { formatDate, localePath, localized } from '../i18n/utils';
import CosImage from './CosImage.astro';

interface Props {
	album: AlbumEntry;
	lang: Lang;
	photoCount: number;
	coverWidth?: number;
	coverHeight?: number;
}

const { album, lang, photoCount, coverWidth, coverHeight } = Astro.props;
const href = localePath(lang, `albums/${album.data.slug}`);
---

<article class="masonry-item group overflow-hidden rounded-2xl border border-ink/10 bg-card shadow-sm transition hover:shadow-md">
	<a href={href} class="block">
		<div class="overflow-hidden bg-canvas">
			<CosImage
				objectKey={album.data.coverKey}
				alt={localized(album.data.title, lang)}
				class="block h-auto w-full transition duration-500 group-hover:scale-[1.01]"
				loading="lazy"
				width={coverWidth}
				height={coverHeight}
			/>
		</div>
		<div class="space-y-2 p-4">
			<time class="text-xs uppercase tracking-wide text-muted" datetime={album.data.publishedAt.toISOString()}>
				{formatDate(album.data.publishedAt, lang)}
			</time>
			<h3 class="text-lg font-semibold leading-snug text-ink">{albumTitle(album, lang)}</h3>
			<p class="text-sm text-muted">{formatAlbumPhotoCount(photoCount, lang)}</p>
			<span class="inline-block text-sm font-medium text-accent">{t('actions', 'viewAlbum', lang)} →</span>
		</div>
	</a>
</article>
