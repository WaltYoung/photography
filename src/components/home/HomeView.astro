---
import AlbumCard from '../AlbumCard.astro';
import CategoryCard from '../CategoryCard.astro';
import CosImage from '../CosImage.astro';
import PhotoCard from '../PhotoCard.astro';
import type { Lang } from '../../types/lang';
import type { SiteThemeVersion } from '../../lib/theme';
import {
	getAlbumsByCategory,
	getCategoriesSorted,
	getAlbumCoverSize,
	getAlbumPhotoCounts,
	getCategoryCoverSize,
	getBio,
	getFeaturedAlbums,
	getFeaturedPhotos,
} from '../../lib/content';
import { t } from '../../i18n/ui';
import { localePath, localized } from '../../i18n/utils';
import { cosUrl } from '../../lib/cos';

interface Props {
	lang: Lang;
	siteTheme: SiteThemeVersion;
}

const { lang, siteTheme } = Astro.props;

const [categories, featuredAlbums, featuredPhotos, bio, photoCounts] = await Promise.all([
	getCategoriesSorted(),
	getFeaturedAlbums(4),
	getFeaturedPhotos(8),
	getBio(lang),
	getAlbumPhotoCounts(),
]);

const categoryCounts = await Promise.all(
	categories.map(async (c) => ({
		category: c,
		count: (await getAlbumsByCategory(c.data.slug)).length,
		cover: await getCategoryCoverSize(c),
	})),
);

const heroPhoto = featuredPhotos[0];
const featuredWithCover = await Promise.all(
	featuredAlbums.map(async (album) => ({
		album,
		cover: await getAlbumCoverSize(album),
	})),
);

const heroBg = heroPhoto ? cosUrl(heroPhoto.data.imageKey) : '';
const isShowcase = siteTheme === '1.1.0';
const bodyClass = isShowcase ? 'home-body home-body--showcase' : 'home-body';
---

<div class={bodyClass}>
{
	isShowcase && heroPhoto && bio ? (
		<section class="showcase-hero mb-14">
			<div class="showcase-hero__media" style={`background-image: url('${heroBg}')`} aria-hidden="true" />
			<div class="showcase-hero__shade" aria-hidden="true" />
			<div class="showcase-hero__content space-y-6">
				<p class="text-xs font-medium uppercase tracking-[0.28em] text-accent">
					{t('home', 'showcaseKicker', lang)}
				</p>
				<div class="space-y-2">
					<h1 class="font-serif text-4xl leading-tight text-ink md:text-6xl">{bio.data.name}</h1>
					<p class="max-w-lg text-base leading-relaxed text-muted md:text-lg">{bio.data.tagline}</p>
				</div>
				<div class="flex flex-wrap gap-3 pt-1">
					<a
						href={localePath(lang, 'albums')}
						class="inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-[#0b100e] transition hover:brightness-105"
					>
						{t('actions', 'viewWork', lang)}
					</a>
					<a
						href={localePath(lang, 'about')}
						class="inline-flex rounded-full border border-ink/25 px-5 py-2.5 text-sm font-medium text-ink transition hover:border-accent/50 hover:text-accent"
					>
						{t('home', 'showcaseAbout', lang)}
					</a>
				</div>
			</div>
		</section>
	) : (
		<section class="mb-12 grid gap-8 md:grid-cols-2 md:items-center">
			<div class="space-y-5">
				{
					bio && (
						<>
							<p class="text-sm uppercase tracking-[0.2em] text-accent">Portfolio</p>
							<h1 class="font-serif text-4xl leading-tight text-ink md:text-5xl">{bio.data.name}</h1>
							<p class="text-lg text-muted">{bio.data.tagline}</p>
						</>
					)
				}
				<a
					href={localePath(lang, 'albums')}
					class="inline-flex rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition hover:bg-accent"
				>
					{t('actions', 'viewWork', lang)}
				</a>
			</div>
			{
				heroPhoto && (
					<figure class="overflow-hidden rounded-2xl border border-ink/10 bg-card p-3 shadow-md">
						<CosImage
							objectKey={heroPhoto.data.imageKey}
							alt={localized(heroPhoto.data.alt, lang)}
							class="block h-auto w-full rounded-xl"
							width={heroPhoto.data.width}
							height={heroPhoto.data.height}
							loading="eager"
						/>
					</figure>
				)
			}
		</section>
	)
}

<div class:list={isShowcase ? 'site-container' : undefined}>
<section class="mb-12">
	<h2 class="mb-5 font-serif text-2xl text-ink">{t('home', 'byCategory', lang)}</h2>
	<div class="grid gap-4">
		{categoryCounts.map(({ category, count, cover }) => (
			<CategoryCard
				category={category}
				lang={lang}
				albumCount={count}
				coverWidth={cover?.width}
				coverHeight={cover?.height}
			/>
		))}
	</div>
</section>

<section class="mb-12">
	<div class="mb-5 flex items-end justify-between gap-4">
		<h2 class="font-serif text-2xl text-ink">{t('home', 'latestAlbums', lang)}</h2>
		<a href={localePath(lang, 'albums')} class="text-sm text-accent">{t('actions', 'allAlbums', lang)}</a>
	</div>
	<div class="masonry">
		{
			featuredWithCover.map(({ album, cover }) => (
				<AlbumCard
					album={album}
					lang={lang}
					photoCount={photoCounts.get(album.data.slug) ?? 0}
					coverWidth={cover?.width}
					coverHeight={cover?.height}
				/>
			))
		}
	</div>
</section>

<section>
	<h2 class="mb-5 font-serif text-2xl text-ink">{t('home', 'featured', lang)}</h2>
	<div class="flex gap-4 overflow-x-auto pb-2">
		{featuredPhotos.map((photo) => (
			<div class="w-56 shrink-0">
				<PhotoCard photo={photo} lang={lang} />
			</div>
		))}
	</div>
</section>
</div>
</div>
