---
import type { Lang } from '../types/lang';
import { t } from '../i18n/ui';
import { SITE_THEME_COOKIE, SITE_THEME_MAX_AGE, SITE_THEME_VERSIONS, type SiteThemeVersion } from '../lib/theme';

interface Props {
	lang: Lang;
	current: SiteThemeVersion;
}

const { lang, current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="theme-version-switch mt-4 border-t border-ink/10 pt-4">
	<p class="mb-2 text-xs uppercase tracking-wider text-muted">{t('footer', 'themeLabel', lang)}</p>
	<div class="flex flex-wrap justify-center gap-2">
		{
			SITE_THEME_VERSIONS.map((version) => (
				<button
					type="button"
					class:list={['theme-switch-btn', { 'is-active': version.id === current }]}
					data-theme-version={version.id}
					title={version.description[lang]}
				>
					{version.label[lang]}
				</button>
			))
		}
	</div>
</div>

<script is:inline define:vars={{ cookieName: SITE_THEME_COOKIE, maxAge: SITE_THEME_MAX_AGE, base }}>
	document.querySelectorAll('[data-theme-version]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const version = btn.getAttribute('data-theme-version');
			if (!version) return;
			const secure = location.protocol === 'https:' ? '; Secure' : '';
			document.cookie =
				cookieName + '=' + encodeURIComponent(version) + '; Path=' + base + '; Max-Age=' + maxAge + '; SameSite=Lax' + secure;
			location.reload();
		});
	});
</script>
