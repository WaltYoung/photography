---
import type { Lang } from '../types/lang';
import ThemeVersionSwitch from './ThemeVersionSwitch.astro';
import { t } from '../i18n/ui';
import { copyrightYears, SITE_PACKAGE_VERSION } from '../lib/site';
import type { SiteThemeVersion } from '../lib/theme';

interface Props {
	lang: Lang;
	siteTheme: SiteThemeVersion;
}

const { lang, siteTheme } = Astro.props;
---

<footer class="mt-16 border-t border-ink/10 bg-card">
	<div class="site-container max-w-none py-8 text-center text-sm text-muted">
		<p>© {copyrightYears()} WaltYoung · v{SITE_PACKAGE_VERSION}</p>
		<p class="mt-2 text-xs">{t('footer', 'stack', lang)}</p>
		<ThemeVersionSwitch lang={lang} current={siteTheme} />
	</div>
</footer>
