---
import type { Lang } from '../types/lang';
import { t } from '../i18n/ui';
import { copyrightYears } from '../lib/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="mt-16 border-t border-ink/10 bg-card">
	<div class="mx-auto max-w-6xl px-4 py-8 text-center text-sm text-muted md:px-6">
		<p>© {copyrightYears()} WaltYoung</p>
		<p class="mt-2 text-xs">{t('footer', 'stack', lang)}</p>
	</div>
</footer>
