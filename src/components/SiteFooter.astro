---
import type { Lang } from '../types/lang';
import { t } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink/10 bg-card">
	<div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-muted md:flex-row md:items-center md:justify-between md:px-6">
		<p>© {year} WaltYoung. {t('footer', 'copyright', lang)}</p>
		<p class="text-xs">Astro · Tencent COS · GitHub Pages</p>
	</div>
</footer>
