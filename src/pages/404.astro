---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import { localePath } from '../i18n/utils';

const lang = 'zh';
---

<BaseLayout lang={lang} path="" title={t('notFound', 'title', lang)}>
	<div class="py-16 text-center">
		<h1 class="font-serif text-4xl text-ink">404</h1>
		<p class="mt-3 text-muted">{t('notFound', 'body', lang)}</p>
		<a href={localePath(lang, '')} class="mt-6 inline-block text-accent hover:underline">
			{t('nav', 'home', lang)}
		</a>
	</div>
</BaseLayout>
