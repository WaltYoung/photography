---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AVATAR_SRC } from '../../lib/branding';
import { getBio } from '../../lib/content';
import { render } from 'astro:content';

const lang = 'en';
const path = 'about';

const bio = await getBio(lang);
if (!bio) {
	return Astro.redirect(`${import.meta.env.BASE_URL}`);
}
const { Content } = await render(bio);
---

<BaseLayout lang={lang} path={path} title={bio.data.name} description={bio.data.tagline}>
	<div class="about-page grid gap-8 md:grid-cols-[240px_1fr]">
		<img
			src={AVATAR_SRC}
			alt={bio.data.name}
			width={512}
			height={512}
			class="aspect-square w-full max-w-xs rounded-2xl border border-ink/10 object-cover shadow-sm"
			loading="eager"
			decoding="async"
		/>
		<div class="space-y-4">
			<h1>{bio.data.name}</h1>
			<p class="about-tagline">{bio.data.tagline}</p>
			<div class="about-prose">
				<Content />
			</div>
			{
				bio.data.social && (
					<ul class="flex flex-wrap gap-3 pt-2 text-sm">
						{bio.data.social.map((s) => (
							<li>
								<a href={s.url} class="text-accent hover:underline" rel="noopener noreferrer">
									{s.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</BaseLayout>
