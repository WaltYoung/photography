---
import AlbumCard from '../../../components/AlbumCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAlbumCoverSize, getAlbumsSorted } from '../../../lib/content';
import { t } from '../../../i18n/ui';

const lang = 'en';
const path = 'albums';
const albums = await getAlbumsSorted();
const albumsWithCover = await Promise.all(
	albums.map(async (album) => ({
		album,
		cover: await getAlbumCoverSize(album),
	})),
);
---

<BaseLayout lang={lang} path={path} title={t('nav', 'albums', lang)}>
	<h1 class="mb-8 font-serif text-3xl text-ink">{t('nav', 'albums', lang)}</h1>
	<div class="masonry">
		{
			albumsWithCover.map(({ album, cover }) => (
				<AlbumCard
					album={album}
					lang={lang}
					coverWidth={cover?.width}
					coverHeight={cover?.height}
				/>
			))
		}
	</div>
</BaseLayout>
