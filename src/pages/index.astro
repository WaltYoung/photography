---
import HomeView from '../components/home/HomeView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPhotos } from '../lib/content';
import { cosUrl } from '../lib/cos';

const lang = 'zh';
const path = '';
const siteTheme = Astro.locals.siteTheme;
const featuredPhotos = await getFeaturedPhotos(8);
const heroPhoto = featuredPhotos[0];
---

<BaseLayout lang={lang} path={path} ogImage={heroPhoto ? cosUrl(heroPhoto.data.imageKey) : undefined}>
	<HomeView lang={lang} siteTheme={siteTheme} />
</BaseLayout>
