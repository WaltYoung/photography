---
import CategoryCard from '../../components/CategoryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlbumsByCategory, getCategoriesSorted } from '../../lib/content';
import { t } from '../../i18n/ui';

const lang = 'zh';
const path = 'categories';

const categories = await getCategoriesSorted();
const withCounts = await Promise.all(
	categories.map(async (category) => ({
		category,
		count: (await getAlbumsByCategory(category.data.slug)).length,
	})),
);
---

<BaseLayout lang={lang} path={path} title={t('nav', 'categories', lang)}>
	<h1 class="mb-8 font-serif text-3xl text-ink">{t('nav', 'categories', lang)}</h1>
	<div class="grid gap-4">
		{withCounts.map(({ category, count }) => (
			<CategoryCard category={category} lang={lang} albumCount={count} />
		))}
	</div>
</BaseLayout>
