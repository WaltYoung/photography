---
import AlbumCard from '../../components/AlbumCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getAlbumCoverSize,
	getAlbumPhotoCounts,
	getAlbumsByCategory,
	getCategoriesSorted,
	getCategoryBySlug,
	categoryTitle,
} from '../../lib/content';
import { localized } from '../../i18n/utils';
import { cosUrl } from '../../lib/cos';

export async function getStaticPaths() {
	const categories = await getCategoriesSorted();
	return categories.map((category) => ({
		params: { slug: category.data.slug },
		props: { category },
	}));
}

const lang = 'zh';
const { category } = Astro.props;
const path = `categories/${category.data.slug}`;
const [albums, photoCounts] = await Promise.all([
	getAlbumsByCategory(category.data.slug),
	getAlbumPhotoCounts(),
]);
const albumsWithCover = await Promise.all(
	albums.map(async (album) => ({
		album,
		cover: await getAlbumCoverSize(album),
	})),
);
---

<BaseLayout
	lang={lang}
	path={path}
	title={categoryTitle(category, lang)}
	description={localized(category.data.description, lang)}
	ogImage={cosUrl(category.data.coverKey)}
	pagefindMeta={{ category: localized(category.data.title, lang) }}
>
	<header class="mb-8 space-y-3">
		<h1 class="font-serif text-3xl text-ink">{categoryTitle(category, lang)}</h1>
		<p class="max-w-2xl text-muted">{localized(category.data.description, lang)}</p>
	</header>
	<div class="masonry">
		{
			albumsWithCover.map(({ album, cover }) => (
				<AlbumCard
					album={album}
					lang={lang}
					photoCount={photoCounts.get(album.data.slug) ?? 0}
					coverWidth={cover?.width}
					coverHeight={cover?.height}
				/>
			))
		}
	</div>
</BaseLayout>
